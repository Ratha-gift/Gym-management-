# ---------------------------------------------------------------------------
# backend-Gym — production .env template
#
# deploy.sh copies this to backend-Gym/.env (only if .env doesn't already
# exist there — it won't clobber a live one on redeploy) and fills in:
#   {{APP_URL}}      -> http://<this instance's public IP>  (or your domain,
#                        if you point one at the Elastic IP — edit below)
#   {{DB_DATABASE}}, {{DB_USERNAME}}, {{DB_PASSWORD}}
#                     -> read from /root/gym_db_credentials.txt, which
#                        server-setup.sh generated
#
# APP_KEY and JWT_SECRET are NOT filled in here — deploy.sh runs
# `php artisan key:generate` and `php artisan jwt:secret` on the server
# itself so those secrets are generated fresh there and never pass through
# this repo or this script.
#
# If you get a real domain later, change APP_URL below (and re-point
# frontend.env.production.example's API_URL too), then re-run deploy.sh.
# ---------------------------------------------------------------------------
APP_NAME="Gym Pro"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL={{APP_URL}}

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE={{DB_DATABASE}}
DB_USERNAME={{DB_USERNAME}}
DB_PASSWORD={{DB_PASSWORD}}

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Note: config/cors.php hardcodes allowed_origins to ['*'] (not read from
# .env), so there's nothing to set here for CORS. That's fine as long as
# the frontend stays same-origin (nginx proxying /api, as deploy.sh sets
# up) — if you ever split the frontend onto a different domain, tighten
# config/cors.php's allowed_origins explicitly rather than adding an env
# var here that the app won't actually read.

JWT_SECRET=
JWT_TTL=10080
