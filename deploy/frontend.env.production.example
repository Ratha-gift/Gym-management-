# ---------------------------------------------------------------------------
# gym-management-app — production .env template
#
# deploy.sh copies this to gym-management-app/.env.production (only if it
# doesn't already exist — won't overwrite a live one on redeploy), filling
# in {{API_URL}} with http://<this instance's public IP>/api.
#
# Vite bakes VITE_* values into the built JS at `npm run build` time, so if
# you change this AFTER the first deploy (e.g. once you have a real domain
# instead of the raw IP), you must re-run deploy.sh to rebuild — editing
# this file alone does nothing until the app is rebuilt.
# ---------------------------------------------------------------------------
VITE_API_URL={{API_URL}}
